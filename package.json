{
  "name": "codebase-health-intelligence",
  "version": "1.0.0",
  "description": "MCP server for AI-powered codebase health analysis, dependency risk scoring, and upgrade intelligence",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "codebase-health-intelligence": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && chmod +x dist/server.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ademyalcin27/codebase-health-intelligence.git"
  },
  "homepage": "https://github.com/ademyalcin27/codebase-health-intelligence#readme",
  "bugs": {
    "url": "https://github.com/ademyalcin27/codebase-health-intelligence/issues"
  },
  "author": "Adem Yalçın <ademyalcin27@gmail.com>",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dependency",
    "security",
    "risk",
    "npm",
    "supply-chain",
    "devtools",
    "claude",
    "ai"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^17.4.2",
    "node-fetch": "^3.3.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
